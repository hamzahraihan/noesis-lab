+// --- Host seam: the classic ESP32's I2C bus, for a bench that wires the chip ---
+//
+// The classic I2C controller is a master that exchanges bytes with attached
+// devices: a transaction exists as the controller's calls into a device, not
+// as a waveform on two pins. A bench's devices live in the host, so these
+// four imports are the seam -- the controller asks, the host answers.
+
+#[cfg(target_arch = "wasm32")]
+#[link(wasm_import_module = "env")]
+extern "C" {
+    fn host_i2c_start(address: u32, read: u32) -> u32;
+    fn host_i2c_write(address: u32, byte: u32) -> u32;
+    fn host_i2c_read(address: u32) -> u32;
+    fn host_i2c_stop(address: u32);
+}
+#[cfg(not(target_arch = "wasm32"))]
+unsafe fn host_i2c_start(_address: u32, _read: u32) -> u32 { 0 }
+#[cfg(not(target_arch = "wasm32"))]
+unsafe fn host_i2c_write(_address: u32, _byte: u32) -> u32 { 0 }
+#[cfg(not(target_arch = "wasm32"))]
+unsafe fn host_i2c_read(_address: u32) -> u32 { 0xff }
+#[cfg(not(target_arch = "wasm32"))]
+unsafe fn host_i2c_stop(_address: u32) {}
+
 pub struct Emu {
