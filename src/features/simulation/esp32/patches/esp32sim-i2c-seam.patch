+/// A device that lives in the host: the controller asks, the host answers.
+///
+/// The controller selects devices by address, so this one answers for every
+/// address and leaves the choice to the host, which knows what is on the
+/// bench's bus and what the firmware addressed.
+struct HostI2c {
+    address: u8,
+}
+
+impl esp_periph::i2c::I2cDevice for HostI2c {
+    fn address(&self, _configured: u8) -> u8 { self.address }
+    fn start_address(&mut self, _configured: u8, address: u8, read: bool) -> bool {
+        self.address = address;
+        // SAFETY: the import is a plain call into the host's function table.
+        unsafe { host_i2c_start(address as u32, u32::from(read)) != 0 }
+    }
+    fn write(&mut self, b: u8) -> bool {
+        // SAFETY: the import is a plain call into the host's function table.
+        unsafe { host_i2c_write(self.address as u32, b as u32) != 0 }
+    }
+    fn read(&mut self) -> u8 {
+        // SAFETY: the import is a plain call into the host's function table.
+        unsafe { host_i2c_read(self.address as u32) as u8 }
+    }
+    fn stop(&mut self) {
+        // SAFETY: the import is a plain call into the host's function table.
+        unsafe { host_i2c_stop(self.address as u32) };
+    }
+}
+
+/// Attach the host's I2C device to the classic ESP32's I2C controller.
+///
+/// The bench's devices are the host's, so the controller needs one to talk
+/// to. Returns 0 on success, 1 when the chip is not a classic ESP32 or the
+/// bus does not exist.
+#[no_mangle]
+pub unsafe extern "C" fn esp32sim_i2c_attach_host(e: *mut Emu, bus: u32) -> u32 {
+    let e = unsafe { &mut *e };
+    match &mut e.m {
+        machine::MachineKind::Esp32(m) => {
+            let Some(i2c) = m.bus.periph.i2c.get_mut(bus as usize) else { return 1 };
+            // 0x7f is no device's address: the host answers for every address,
+            // and this is only the slot the controller keeps it in.
+            i2c.attach(0x7f, Box::new(HostI2c { address: 0x7f }));
+            0
+        }
+        _ => 1,
+    }
+}
