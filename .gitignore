# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Secrets: environment files and credential material stay out of the repo, so a
# read tool cannot pull them into a prompt and a `git add .` cannot commit them.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
credentials.json
secrets.json
secrets.yml
secrets.yaml

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Isolated worktrees (superpowers:using-git-worktrees)
.worktrees/

# Local-only planning workspace: specs and plans that stay uncommitted
.superpowers/plans/

# Agent/tool workspaces: plans, reports and design-tool state stay local
docs/superpowers/
docs/wokwi-*.md
task-*-report.md
.impeccable/

# Wasm build temp files (scripts/build-avr-wasm.mjs)
src/features/simulation/avr/wasm/.build-tmp-*
graphify-out/
.opencode/
.omo/

# husky internals
.husky/_
