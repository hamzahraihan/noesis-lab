{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PartStateSnapshot ABI",
  "type": "object",
  "required": ["version", "parts"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["partId", "kind"],
        "properties": {
          "partId": { "type": "string" },
          "kind": { "type": "string", "enum": ["resistor", "capacitor", "led", "button", "potentiometer", "powerSupply", "breadboard", "mcu", "shift595", "pcf8574", "mcp23017", "ads1115", "max7219", "pcd8544", "tm1637", "stepper", "max6675", "mcp4725", "eeprom24lc256", "ds3231", "bmp180", "ina219", "bh1750", "tmp102", "sht31", "rc522", "pca9685", "a4988", "scripted"] }
        }
      }
    }
  },
  "definitions": {
    "PartStateSnapshot": {
      "type": "object",
      "description": "Complete part state snapshot matching C++ PartStateSnapshot struct (packed, no padding)",
      "required": [],
      "properties": {
        "partId": { "type": "string" },
        "kind": { "type": "string", "enum": ["resistor", "capacitor", "led", "button", "potentiometer", "powerSupply", "breadboard", "mcu", "shift595", "pcf8574", "mcp23017", "ads1115", "max7219", "pcd8544", "tm1637", "stepper", "max6675", "mcp4725", "eeprom24lc256", "ds3231", "bmp180", "ina219", "bh1750", "tmp102", "sht31", "rc522", "pca9685", "a4988", "scripted"] },
        "framebuffer": { "type": "integer", "description": "WASM memory offset to framebuffer data (converted from pointer)" },
        "framebuffer_size": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "servo_angle": { "type": "integer" },
        "stepper_angle_deci_deg": { "type": "integer" },
        "stepper_driver_outputs": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
        "seven_seg_digits": { "type": "array", "items": { "type": "integer" }, "minItems": 8, "maxItems": 8 },
        "seven_seg_colon": { "type": "integer" },
        "lcd_chars": { "type": "array", "items": { "type": "integer" }, "minItems": 80, "maxItems": 80 },
        "lcd_rows": { "type": "integer" },
        "lcd_cols": { "type": "integer" },
        "shift_register_outputs": { "type": "array", "items": { "type": "integer" }, "minItems": 8, "maxItems": 8 },
        "relay_contacts_closed": { "type": "boolean" },
        "button_pressed": { "type": "boolean" },
        "pot_wiper": { "type": "number" },
        "rfid_card_present": { "type": "boolean" },
        "thermocouple_temp_quarter_deg": { "type": "integer" },
        "pcf8574_output_reg": { "type": "integer" },
        "pcf8574_input_reg": { "type": "integer" },
        "mcp23017_iodira": { "type": "integer" },
        "mcp23017_iodirb": { "type": "integer" },
        "mcp23017_gpioa": { "type": "integer" },
        "mcp23017_gpiob": { "type": "integer" },
        "mcp23017_olata": { "type": "integer" },
        "mcp23017_olatb": { "type": "integer" },
        "ads1115_config": { "type": "integer" },
        "ads1115_conversion": { "type": "integer" },
        "ads1115_conversion_ready": { "type": "boolean" },
        "shift595_shift_reg": { "type": "integer" },
        "shift595_storage_reg": { "type": "integer" },
        "shift595_outputs_enabled": { "type": "boolean" },
        "pcd8544_x": { "type": "integer" },
        "pcd8544_y": { "type": "integer" },
        "pcd8544_vertical": { "type": "boolean" },
        "pcd8544_extended": { "type": "boolean" },
        "pcd8544_powerDown": { "type": "boolean" },
        "pcd8544_blanked": { "type": "boolean" },
        "pcd8544_inverse": { "type": "boolean" },
        "pcd8544_vop": { "type": "integer" },
        "mcp4725_value": { "type": "integer" },
        "pca9685_channels": { "type": "array", "items": { "type": "integer" }, "minItems": 16, "maxItems": 16 },
        "pca9685_prescale": { "type": "integer" },
        "rtc_seconds": { "type": "integer" },
        "rtc_minutes": { "type": "integer" },
        "rtc_hours": { "type": "integer" },
        "rtc_day": { "type": "integer" },
        "rtc_date": { "type": "integer" },
        "rtc_month": { "type": "integer" },
        "rtc_year": { "type": "integer" },
        "sensor_temp_milli_c": { "type": "integer" },
        "sensor_pressure_pa": { "type": "integer" },
        "sensor_lux": { "type": "integer" },
        "sensor_humidity_milli_pct": { "type": "integer" },
        "max7219_decode_mode": { "type": "integer" },
        "max7219_intensity": { "type": "integer" },
        "max7219_scan_limit": { "type": "integer" },
        "max7219_shutdown": { "type": "boolean" },
        "max7219_display_test": { "type": "boolean" }
      }
    }
  }
}