{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PartStateSnapshot ABI",
  "type": "object",
  "required": ["version", "parts"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["partId", "kind"],
        "properties": {
          "partId": { "type": "string" },
          "kind": { "type": "string", "enum": ["resistor", "capacitor", "led", "button", "potentiometer", "powerSupply", "breadboard", "mcu", "shift595", "pcf8574", "mcp23017", "ads1115", "max7219", "pcd8544", "tm1637", "stepper", "max6675", "mcp4725", "eeprom24lc256", "ds3231", "bmp180", "ina219", "bh1750", "tmp102", "sht31", "rc522", "pca9685", "a4988", "scripted", "sonar"] }
        }
      }
    }
  },
  "definitions": {
    "PartStateSnapshot": {
      "type": "object",
      "description": "Complete part state snapshot matching C++ PartStateSnapshot struct (packed, no padding)",
      "required": [],
      "properties": {
        "partId": { "type": "string" },
        "kind": { "type": "string", "enum": ["resistor", "capacitor", "led", "button", "potentiometer", "powerSupply", "breadboard", "mcu", "shift595", "pcf8574", "mcp23017", "ads1115", "max7219", "pcd8544", "tm1637", "stepper", "max6675", "mcp4725", "eeprom24lc256", "ds3231", "bmp180", "ina219", "bh1750", "tmp102", "sht31", "rc522", "pca9685", "a4988", "scripted", "sonar"] },
        "framebuffer": { "type": "integer", "description": "WASM memory offset to framebuffer data (converted from pointer)" },
        "framebuffer_size": { "type": "integer" },
        "width": { "type": "integer" },
        "height": { "type": "integer" },
        "servo_angle": { "type": "integer" },
        "stepper_angle_deci_deg": { "type": "integer" },
        "stepper_driver_outputs": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
        "seven_seg_digits": { "type": "array", "items": { "type": "integer" }, "minItems": 8, "maxItems": 8 },
        "seven_seg_colon": { "type": "integer" },
        "lcd_chars": { "type": "array", "items": { "type": "integer" }, "minItems": 80, "maxItems": 80 },
        "lcd_rows": { "type": "integer" },
        "lcd_cols": { "type": "integer" },
        "shift_register_outputs": { "type": "array", "items": { "type": "integer" }, "minItems": 8, "maxItems": 8 },
        "relay_contacts_closed": { "type": "boolean" },
        "button_pressed": { "type": "boolean" },
        "pot_wiper": { "type": "number" },
        "rfid_card_present": { "type": "boolean" },
        "thermocouple_temp_quarter_deg": { "type": "integer" },
        "pcf8574_output_reg": { "type": "integer" },
        "pcf8574_input_reg": { "type": "integer" },
        "mcp23017_iodira": { "type": "integer" },
        "mcp23017_iodirb": { "type": "integer" },
        "mcp23017_gpioa": { "type": "integer" },
        "mcp23017_gpiob": { "type": "integer" },
        "mcp23017_olata": { "type": "integer" },
        "mcp23017_olatb": { "type": "integer" },
        "ads1115_config": { "type": "integer" },
        "ads1115_conversion": { "type": "integer" },
        "ads1115_conversion_ready": { "type": "boolean" },
        "shift595_shift_reg": { "type": "integer" },
        "shift595_storage_reg": { "type": "integer" },
        "shift595_outputs_enabled": { "type": "boolean" },
        "pcd8544_x": { "type": "integer" },
        "pcd8544_y": { "type": "integer" },
        "pcd8544_vertical": { "type": "boolean" },
        "pcd8544_extended": { "type": "boolean" },
        "pcd8544_powerDown": { "type": "boolean" },
        "pcd8544_blanked": { "type": "boolean" },
        "pcd8544_inverse": { "type": "boolean" },
        "pcd8544_vop": { "type": "integer" },
        "mcp4725_value": { "type": "integer" },
        "pca9685_duty": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 4096 }, "minItems": 16, "maxItems": 16 },
        "pca9685_prescale": { "type": "integer" },
        "rtc_seconds": { "type": "integer" },
        "rtc_minutes": { "type": "integer" },
        "rtc_hours": { "type": "integer" },
        "rtc_day": { "type": "integer" },
        "rtc_date": { "type": "integer" },
        "rtc_month": { "type": "integer" },
        "rtc_year": { "type": "integer" },
        "sensor_temp_milli_c": { "type": "integer" },
        "sensor_pressure_pa": { "type": "integer" },
        "sensor_lux": { "type": "integer" },
        "sensor_humidity_milli_pct": { "type": "integer" },
        "max7219_decode_mode": { "type": "integer" },
        "max7219_intensity": { "type": "integer" },
        "max7219_scan_limit": { "type": "integer" },
        "max7219_shutdown": { "type": "boolean" },
        "max7219_display_test": { "type": "boolean" },
        "sonar_echo_us": { "type": "integer", "description": "HC-SR04 echo pulse width in microseconds; echo_us = round(distance_cm * 58)", "minimum": 0, "maximum": 65535 },
        "neopixel_count": { "type": "integer", "description": "Number of pixels on the NeoPixel strip", "minimum": 0, "maximum": 255 },
        "neopixel_pixel0_r": { "type": "integer", "description": "Pixel 0 red channel (0-255)" },
        "neopixel_pixel0_g": { "type": "integer", "description": "Pixel 0 green channel (0-255)" },
        "neopixel_pixel0_b": { "type": "integer", "description": "Pixel 0 blue channel (0-255)" },
        "neopixel_pixel1_r": { "type": "integer", "description": "Pixel 1 red channel (0-255)" },
        "neopixel_pixel1_g": { "type": "integer", "description": "Pixel 1 green channel (0-255)" },
        "neopixel_pixel1_b": { "type": "integer", "description": "Pixel 1 blue channel (0-255)" },
        "neopixel_pixel2_r": { "type": "integer", "description": "Pixel 2 red channel (0-255)" },
        "neopixel_pixel2_g": { "type": "integer", "description": "Pixel 2 green channel (0-255)" },
        "neopixel_pixel2_b": { "type": "integer", "description": "Pixel 2 blue channel (0-255)" },
        "neopixel_pixel3_r": { "type": "integer", "description": "Pixel 3 red channel (0-255)" },
        "neopixel_pixel3_g": { "type": "integer", "description": "Pixel 3 green channel (0-255)" },
        "neopixel_pixel3_b": { "type": "integer", "description": "Pixel 3 blue channel (0-255)" },
        "scripted_reg_ptr": { "type": "integer", "description": "Scripted I2C register pointer", "minimum": 0, "maximum": 255 },
        "scripted_reg_0": { "type": "integer", "description": "Scripted register 0", "minimum": 0, "maximum": 255 },
        "scripted_reg_1": { "type": "integer", "description": "Scripted register 1", "minimum": 0, "maximum": 255 },
        "scripted_reg_2": { "type": "integer", "description": "Scripted register 2", "minimum": 0, "maximum": 255 },
        "scripted_reg_3": { "type": "integer", "description": "Scripted register 3", "minimum": 0, "maximum": 255 },
        "scripted_reg_4": { "type": "integer", "description": "Scripted register 4", "minimum": 0, "maximum": 255 },
        "scripted_reg_5": { "type": "integer", "description": "Scripted register 5", "minimum": 0, "maximum": 255 },
        "scripted_reg_6": { "type": "integer", "description": "Scripted register 6", "minimum": 0, "maximum": 255 },
        "scripted_reg_7": { "type": "integer", "description": "Scripted register 7", "minimum": 0, "maximum": 255 },
        "dialer_digit": { "type": "integer", "description": "Rotary dialer digit knob (0-9)", "minimum": 0, "maximum": 9 },
        "ir_code": { "type": "integer", "description": "IR remote current code (0 when not pressed)", "minimum": 0, "maximum": 65535 }
      }
    }
  }
}