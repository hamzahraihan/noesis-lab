{
  "name": "noesis-lab",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:solver && npm run build:engine && npm run build:engine:ffi && tsc -b && vite build",
    "build:wasm": "node scripts/build-avr-wasm.mjs",
    "build:solver": "node scripts/build-solver-wasm.mjs",
    "build:engine": "node scripts/build-engine-wasm.mjs",
    "build:engine:ffi": "node scripts/build-engine-ffi-wasm.mjs",
    "build:parts": "node scripts/build-parts-wasm.mjs",
    "build:parts:probe": "node scripts/build-parts-probe.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "format": "oxfmt src scripts",
    "format:check": "oxfmt --check src scripts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:native": "node scripts/check-native.mjs",
    "generate:gallery": "tsx scripts/generate-gallery.ts",
    "generate:abi": "tsx scripts/generate-abi.ts",
    "generate:ffi": "tsx scripts/generate-ffi.ts",
    "update:docs-counts": "tsx scripts/update-docs-counts.ts",
    "prepare": "husky && npm run generate:gallery && npm run generate:abi && npm run generate:ffi",
    "preview": "vite preview",
    "check": "npm run typecheck && npm run lint && npm run check:boundaries && npm run check:native && npm test"
  },
  "dependencies": {
    "@horang-corp/avr-gcc-wasm": "0.2.0",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "0.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "littlefs": "0.1.0",
    "lucide-react": "^1.52.0",
    "lz-string": "^1.5.0",
    "monaco-editor": "^0.57.0",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "rp2040js": "1.4.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@webassemblyjs/wasm-opt": "^1.14.1",
    "ajv-cli": "^5.0.0",
    "assemblyscript": "0.27.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wabt": "^1.0.35"
  }
}
